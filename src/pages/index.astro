---
import Layout from '../layouts/Layout.astro';
import { VET_SERVICES, CARE_TIPS, AVAILABLE_HOURS } from '../data/vetData';
---

<Layout title="PawCare Clínica Veterinaria | Gestión de Citas y Bienestar Animal">
  <!-- NAVBAR -->
  <header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
      <a href="#" class="flex items-center gap-3 group">
        <div class="w-11 h-11 rounded-xl bg-teal-600 flex items-center justify-center text-white text-2xl shadow-md shadow-teal-600/20 group-hover:scale-105 transition">
          🐾
        </div>
        <div>
          <span class="text-xl font-extrabold tracking-tight text-slate-900">PawCare</span>
          <span class="block text-xs font-semibold text-teal-600 uppercase tracking-wider">Clínica Veterinaria</span>
        </div>
      </a>

      <nav class="hidden md:flex items-center gap-8 text-sm font-semibold text-slate-600">
        <a href="#servicios" class="hover:text-teal-600 transition">Servicios Clínicos</a>
        <a href="#agendamiento" class="hover:text-teal-600 transition">Agendar Cita</a>
        <a href="#consejos" class="hover:text-teal-600 transition">Consejos de Cuidado</a>
      </nav>

      <div class="flex items-center gap-3">
        <a
          href="#agendamiento"
          class="inline-flex items-center gap-2 bg-teal-600 hover:bg-teal-700 text-white text-sm font-bold px-5 py-2.5 rounded-xl shadow-sm transition"
        >
          <span>📅</span>
          <span>Reservar Cita</span>
        </a>
      </div>
    </div>
  </header>

  <main>
    <!-- HERO SECTION -->
    <section class="relative overflow-hidden bg-linear-to-b from-teal-50/70 via-white to-slate-50 pt-12 pb-20 lg:pt-20 lg:pb-28">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-teal-100/80 text-teal-800 text-xs font-bold uppercase tracking-wider">
            <span class="w-2 h-2 rounded-full bg-teal-600 animate-pulse"></span>
            Atención Veterinaria Integral en Medellín
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 tracking-tight leading-[1.12]">
            Cuidado médico experto para quienes son <span class="text-teal-600">parte de tu familia.</span>
          </h1>

          <p class="text-lg text-slate-600 max-w-2xl leading-relaxed">
            Agenda tu consulta en menos de 60 segundos, consulta tarifas transparentes y accede a guías clínicas de prevención elaboradas por especialistas.
          </p>

          <div class="flex flex-wrap gap-4 pt-2">
            <a
              href="#agendamiento"
              class="inline-flex items-center justify-center gap-2 bg-teal-600 hover:bg-teal-700 text-white font-bold px-7 py-4 rounded-2xl shadow-lg shadow-teal-600/20 transition transform hover:-translate-y-0.5"
            >
              Agendar Cita Ahora
              <span aria-hidden="true">→</span>
            </a>
            <a
              href="#servicios"
              class="inline-flex items-center justify-center gap-2 bg-white hover:bg-slate-100 text-slate-800 font-bold px-7 py-4 rounded-2xl border border-slate-200 transition"
            >
              Explorar Servicios
            </a>
          </div>

          <div class="grid grid-cols-3 gap-6 pt-6 border-t border-slate-200/80 max-w-lg">
            <div>
              <p class="text-2xl font-extrabold text-slate-900">+4.800</p>
              <p class="text-xs font-medium text-slate-500">Mascotas atendidas</p>
            </div>
            <div>
              <p class="text-2xl font-extrabold text-teal-600">99.2%</p>
              <p class="text-xs font-medium text-slate-500">Citas sin espera</p>
            </div>
            <div>
              <p class="text-2xl font-extrabold text-amber-500">24/7</p>
              <p class="text-xs font-medium text-slate-500">Soporte Triage</p>
            </div>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="relative bg-white p-6 sm:p-8 rounded-3xl shadow-xl border border-slate-100">
            <div class="flex items-center justify-between pb-6 mb-6 border-b border-slate-100">
              <div class="flex items-center gap-3">
                <span class="text-3xl">🐕‍🦺</span>
                <div>
                  <h2 class="font-bold text-slate-900">Estado de Clínica en Vivo</h2>
                  <p class="text-xs text-slate-500">Sede Laureles - Poblado</p>
                </div>
              </div>
              <span class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800">
                Consultorios Disponibles
              </span>
            </div>

            <div class="space-y-4">
              <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100 flex items-center justify-between">
                <div>
                  <p class="text-xs font-bold text-teal-700 uppercase">Tiempo promedio de ingreso</p>
                  <p class="text-lg font-extrabold text-slate-900">Menos de 5 minutos</p>
                </div>
                <span class="text-2xl">⏱️</span>
              </div>

              <div class="p-4 rounded-2xl bg-amber-50/70 border border-amber-200/60">
                <p class="text-xs font-bold text-amber-800 uppercase mb-1">💡 Tip del Día</p>
                <p class="text-sm text-amber-900">
                  Recuerda traer el carné de vacunación físico o digital para agilizar el ingreso a consulta general.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 1. SECCIÓN DE SERVICIOS -->
    <section id="servicios" class="py-20 bg-white border-t border-slate-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-14">
          <span class="text-xs font-bold uppercase tracking-widest text-teal-600">Catálogo Clínico</span>
          <h2 class="mt-2 text-3xl sm:text-4xl font-extrabold text-slate-900">
            Servicios Veterinarios Especializados
          </h2>
          <p class="mt-3 text-slate-600">
            Selecciona cualquier servicio para pre-cargarlo automáticamente en el simulador de agendamiento.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {VET_SERVICES.map((service) => (
            <article class="flex flex-col justify-between rounded-2xl border border-slate-200 p-6 hover:border-teal-500 hover:shadow-lg transition bg-slate-50/40">
              <div>
                <div class="flex items-center justify-between gap-2 mb-4">
                  <span class="w-12 h-12 rounded-2xl bg-teal-50 border border-teal-100 flex items-center justify-center text-2xl">
                    {service.icon}
                  </span>
                  <div class="flex items-center gap-2">
                    {service.badge && (
                      <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800">
                        {service.badge}
                      </span>
                    )}
                    <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-200/70 text-slate-700">
                      {service.category}
                    </span>
                  </div>
                </div>

                <h3 class="text-xl font-bold text-slate-900 mb-2">{service.name}</h3>
                <p class="text-sm text-slate-600 leading-relaxed mb-6">{service.description}</p>
              </div>

              <div class="pt-4 border-t border-slate-200/80 flex items-center justify-between">
                <div>
                  <span class="block text-xs text-slate-500">Duración: {service.duration}</span>
                  <span class="text-lg font-extrabold text-slate-900">{service.price}</span>
                </div>

                <button
                  type="button"
                  data-service-id={service.id}
                  class="select-service-btn inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-teal-600 hover:bg-teal-700 text-white text-xs font-bold transition cursor-pointer"
                >
                  Agendar este
                  <span aria-hidden="true">→</span>
                </button>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 2. SIMULADOR DE AGENDAMIENTO INTERACTIVO -->
    <section id="agendamiento" class="py-20 bg-slate-900 text-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mb-12">
          <span class="text-xs font-bold uppercase tracking-widest text-teal-400">Simulador Interactivo SDD</span>
          <h2 class="mt-2 text-3xl sm:text-4xl font-extrabold">
            Agendamiento de Citas en Tiempo Real
          </h2>
          <p class="mt-3 text-slate-300">
            Completa los datos de tu mascota. El sistema verifica disponibilidad de horarios en el estado local y genera tu orden clínica al instante.
          </p>
        </div>

        <div class="grid lg:grid-cols-12 gap-8 items-start">
          <!-- Formulario -->
          <form
            id="booking-form"
            class="lg:col-span-7 bg-slate-800/90 border border-slate-700 rounded-3xl p-6 sm:p-8 space-y-6"
            novalidate
          >
            <div class="grid sm:grid-cols-2 gap-5">
              <div>
                <label for="ownerName" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">
                  Nombre del Propietario *
                </label>
                <input
                  id="ownerName"
                  name="ownerName"
                  type="text"
                  required
                  placeholder="Ej. Carolina Gómez"
                  class="w-full rounded-xl bg-slate-900 border border-slate-700 px-4 py-3 text-sm text-white placeholder-slate-500 focus:border-teal-400 focus:outline-none"
                />
              </div>

              <div>
                <label for="ownerPhone" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">
                  WhatsApp / Teléfono *
                </label>
                <input
                  id="ownerPhone"
                  name="ownerPhone"
                  type="tel"
                  required
                  placeholder="Ej. 300 123 4567"
                  class="w-full rounded-xl bg-slate-900 border border-slate-700 px-4 py-3 text-sm text-white placeholder-slate-500 focus:border-teal-400 focus:outline-none"
                />
              </div>
            </div>

            <div class="grid sm:grid-cols-2 gap-5">
              <div>
                <label for="petName" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">
                  Nombre de la Mascota *
                </label>
                <input
                  id="petName"
                  name="petName"
                  type="text"
                  required
                  placeholder="Ej. Bruno / Michi"
                  class="w-full rounded-xl bg-slate-900 border border-slate-700 px-4 py-3 text-sm text-white placeholder-slate-500 focus:border-teal-400 focus:outline-none"
                />
              </div>

              <div>
                <label for="petSpecies" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">
                  Especie *
                </label>
                <select
                  id="petSpecies"
                  name="petSpecies"
                  required
                  class="w-full rounded-xl bg-slate-900 border border-slate-700 px-4 py-3 text-sm text-white focus:border-teal-400 focus:outline-none"
                >
                  <option value="Perro">🐶 Perro (Canino)</option>
                  <option value="Gato">🐱 Gato (Felino)</option>
                  <option value="Exótico">🦜 Ave / Exótico</option>
                </select>
              </div>
            </div>

            <div>
              <label for="serviceId" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">
                Servicio Clínico Requerido *
              </label>
              <select
                id="serviceId"
                name="serviceId"
                required
                class="w-full rounded-xl bg-slate-900 border border-slate-700 px-4 py-3 text-sm text-white focus:border-teal-400 focus:outline-none"
              >
                {VET_SERVICES.map((s) => (
                  <option value={s.id}>
                    {s.name} — {s.price} ({s.duration})
                  </option>
                ))}
              </select>
            </div>

            <div class="grid sm:grid-cols-2 gap-5">
              <div>
                <label for="appointmentDate" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">
                  Fecha de la Cita *
                </label>
                <input
                  id="appointmentDate"
                  name="appointmentDate"
                  type="date"
                  required
                  class="w-full rounded-xl bg-slate-900 border border-slate-700 px-4 py-3 text-sm text-white focus:border-teal-400 focus:outline-none"
                />
              </div>

              <div>
                <label for="appointmentTime" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">
                  Franja Horaria *
                </label>
                <select
                  id="appointmentTime"
                  name="appointmentTime"
                  required
                  class="w-full rounded-xl bg-slate-900 border border-slate-700 px-4 py-3 text-sm text-white focus:border-teal-400 focus:outline-none"
                >
                  {AVAILABLE_HOURS.map((hour) => (
                    <option value={hour}>{hour}</option>
                  ))}
                </select>
              </div>
            </div>

            <div>
              <label for="symptoms" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">
                Motivo de Consulta / Síntomas Observados
              </label>
              <textarea
                id="symptoms"
                name="symptoms"
                rows="3"
                placeholder="Describe brevemente el motivo de la visita, comportamiento o dudas..."
                class="w-full rounded-xl bg-slate-900 border border-slate-700 px-4 py-3 text-sm text-white placeholder-slate-500 focus:border-teal-400 focus:outline-none"
              ></textarea>
            </div>

            <div
              id="form-feedback"
              role="status"
              aria-live="polite"
              class="hidden rounded-xl px-4 py-3 text-sm font-semibold"
            ></div>

            <button
              type="submit"
              class="w-full bg-teal-500 hover:bg-teal-400 text-slate-950 font-extrabold py-4 px-6 rounded-2xl shadow-lg transition cursor-pointer"
            >
              Confirmar Agendamiento Simulado
            </button>
          </form>

          <!-- Panel de Citas Agendadas en Vivo -->
          <div class="lg:col-span-5 bg-slate-800/60 border border-slate-700 rounded-3xl p-6 sm:p-8 space-y-5">
            <div class="flex items-center justify-between border-b border-slate-700 pb-4">
              <div>
                <h3 class="text-lg font-bold text-white">Mis Citas Programadas</h3>
                <p class="text-xs text-slate-400">Persistidas en el navegador (LocalStorage)</p>
              </div>
              <span
                id="appointments-count"
                class="px-3 py-1 rounded-full bg-teal-500/20 text-teal-300 text-xs font-bold"
              >
                0 activas
              </span>
            </div>

            <div id="appointments-list" class="space-y-4 max-h-115 overflow-y-auto pr-1">
              <!-- Se llena dinámicamente con JS seguro -->
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. SECCIÓN DE CONSEJOS DE CUIDADO ANIMAL -->
    <section id="consejos" class="py-20 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
          <div>
            <span class="text-xs font-bold uppercase tracking-widest text-teal-600">Educación para Tutores</span>
            <h2 class="mt-2 text-3xl sm:text-4xl font-extrabold text-slate-900">
              Guía Interactiva de Cuidado Animal
            </h2>
          </div>

          <!-- Buscador y Filtros -->
          <div class="flex flex-col sm:flex-row gap-3">
            <input
              id="tip-search"
              type="search"
              placeholder="Buscar ej. chocolate, calor, gatos..."
              class="rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm text-slate-800 focus:border-teal-600 focus:outline-none"
            />
            <div class="flex flex-wrap gap-2" id="tip-filters">
              {['Todos', 'Nutrición', 'Prevención', 'Primeros Auxilios', 'Comportamiento'].map((cat, idx) => (
                <button
                  type="button"
                  data-category={cat}
                  class={`tip-filter-btn px-3.5 py-2 rounded-xl text-xs font-bold transition cursor-pointer ${
                    idx === 0
                      ? 'bg-teal-600 text-white'
                      : 'bg-white text-slate-700 border border-slate-200 hover:bg-slate-100'
                  }`}
                >
                  {cat}
                </button>
              ))}
            </div>
          </div>
        </div>

        <div id="tips-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {CARE_TIPS.map((tip) => (
            <article
              data-category={tip.category}
              data-title={tip.title.toLowerCase()}
              data-summary={tip.summary.toLowerCase()}
              class="tip-card bg-white rounded-2xl border border-slate-200 p-6 shadow-sm flex flex-col justify-between"
            >
              <div>
                <div class="flex items-center justify-between gap-2 mb-3">
                  <span class="px-3 py-1 rounded-full text-xs font-bold bg-teal-50 text-teal-700">
                    {tip.category}
                  </span>
                  <span class="text-xs font-semibold text-slate-400">
                    🐾 {tip.petType} • {tip.readTime}
                  </span>
                </div>

                <h3 class="text-lg font-bold text-slate-900 mb-2">{tip.title}</h3>
                <p class="text-sm text-slate-600 mb-4">{tip.summary}</p>
              </div>

              <div class="bg-slate-50 rounded-xl p-4 border border-slate-100">
                <p class="text-xs font-bold uppercase text-slate-700 mb-2">Pasos recomendados:</p>
                <ul class="space-y-1.5 text-xs text-slate-600">
                  {tip.actionSteps.map((step) => (
                    <li class="flex items-start gap-2">
                      <span class="text-teal-600 font-bold">✓</span>
                      <span>{step}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <!-- FOOTER -->
  <footer class="bg-slate-950 text-slate-400 py-12 border-t border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm">
      <p>© 2026 PawCare Clínica Veterinaria — Taller SDD (Diseño de Sistemas ITM).</p>
      <p class="text-xs text-slate-500">Desarrollado con Astro + Tailwind CSS siguiendo Spec-Driven Development.</p>
    </div>
  </footer>

  <!-- LÓGICA INTERACTIVA DEL CLIENTE (SANITIZADA Y VALIDADA) -->
  <script>
    interface StoredAppointment {
      code: string;
      ownerName: string;
      ownerPhone: string;
      petName: string;
      petSpecies: string;
      serviceName: string;
      date: string;
      time: string;
      symptoms: string;
    }

    const STORAGE_KEY = 'pawcare_sdd_appointments_v1';

    // Configurar fecha mínima = Hoy
    const dateInput = document.getElementById('appointmentDate') as HTMLInputElement | null;
    if (dateInput) {
      const today = new Date().toISOString().split('T')[0];
      dateInput.min = today;
      dateInput.value = today;
    }

    // Conectar botones "Agendar este" del catálogo con el formulario
    const serviceSelect = document.getElementById('serviceId') as HTMLSelectElement | null;
    document.querySelectorAll('.select-service-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const serviceId = btn.getAttribute('data-service-id');
        if (serviceSelect && serviceId) {
          serviceSelect.value = serviceId;
          document.getElementById('agendamiento')?.scrollIntoView({ behavior: 'smooth' });
          serviceSelect.focus();
        }
      });
    });

    function getAppointments(): StoredAppointment[] {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        return raw ? JSON.parse(raw) : [];
      } catch {
        return [];
      }
    }

    function saveAppointments(list: StoredAppointment[]): void {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
    }

    // Renderizado seguro (Prevención XSS usando createElement y textContent)
    function renderAppointments(): void {
      const container = document.getElementById('appointments-list');
      const countBadge = document.getElementById('appointments-count');
      if (!container || !countBadge) return;

      const list = getAppointments();
      countBadge.textContent = `${list.length} ${list.length === 1 ? 'activa' : 'activas'}`;
      container.replaceChildren();

      if (list.length === 0) {
        const empty = document.createElement('div');
        empty.className = 'text-center py-10 text-slate-400 text-sm';
        empty.textContent = 'Aún no tienes citas registradas. Usa el formulario para simular tu primera reserva.';
        container.appendChild(empty);
        return;
      }

      list.forEach((item) => {
        const card = document.createElement('div');
        card.className = 'p-4 rounded-2xl bg-slate-900 border border-slate-700 space-y-2';

        const header = document.createElement('div');
        header.className = 'flex items-center justify-between';

        const badge = document.createElement('span');
        badge.className = 'text-xs font-extrabold text-teal-400';
        badge.textContent = `#${item.code} • ${item.date} (${item.time})`;

        const cancelBtn = document.createElement('button');
        cancelBtn.type = 'button';
        cancelBtn.className = 'text-xs text-rose-400 hover:text-rose-300 font-bold cursor-pointer';
        cancelBtn.textContent = 'Cancelar';
        cancelBtn.addEventListener('click', () => {
          const updated = getAppointments().filter((a) => a.code !== item.code);
          saveAppointments(updated);
          renderAppointments();
        });

        header.appendChild(badge);
        header.appendChild(cancelBtn);

        const title = document.createElement('p');
        title.className = 'text-sm font-bold text-white';
        title.textContent = `${item.petName} (${item.petSpecies}) — ${item.serviceName}`;

        const meta = document.createElement('p');
        meta.className = 'text-xs text-slate-400';
        meta.textContent = `Tutor: ${item.ownerName} • Tel: ${item.ownerPhone}`;

        card.appendChild(header);
        card.appendChild(title);
        card.appendChild(meta);

        if (item.symptoms) {
          const notes = document.createElement('p');
          notes.className = 'text-xs text-slate-300 italic pt-1 border-t border-slate-800';
          notes.textContent = `"${item.symptoms}"`;
          card.appendChild(notes);
        }

        container.appendChild(card);
      });
    }

    // Manejo de envío del formulario
    const form = document.getElementById('booking-form') as HTMLFormElement | null;
    const feedback = document.getElementById('form-feedback');

    function showFeedback(message: string, isError: boolean) {
      if (!feedback) return;
      feedback.textContent = message;
      feedback.className = `rounded-xl px-4 py-3 text-sm font-semibold ${
        isError ? 'bg-rose-500/20 text-rose-200 border border-rose-500/40' : 'bg-emerald-500/20 text-emerald-200 border border-emerald-500/40'
      }`;
    }

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = new FormData(form);

      const ownerName = String(formData.get('ownerName') || '').trim();
      const ownerPhone = String(formData.get('ownerPhone') || '').trim();
      const petName = String(formData.get('petName') || '').trim();
      const petSpecies = String(formData.get('petSpecies') || '').trim();
      const date = String(formData.get('appointmentDate') || '').trim();
      const time = String(formData.get('appointmentTime') || '').trim();
      const symptoms = String(formData.get('symptoms') || '').trim();

      const selectedOption = serviceSelect?.options[serviceSelect.selectedIndex];
      const serviceName = selectedOption ? selectedOption.text.split(' — ')[0] : 'Consulta';

      if (!ownerName || !ownerPhone || !petName || !date || !time) {
        showFeedback('Por favor completa todos los campos obligatorios marcados con (*).', true);
        return;
      }

      const currentList = getAppointments();
      const slotTaken = currentList.some((a) => a.date === date && a.time === time);
      if (slotTaken) {
        showFeedback(`El horario ${time} del ${date} ya se encuentra reservado. Elige otra franja.`, true);
        return;
      }

      const newAppointment: StoredAppointment = {
        code: `VET-${Math.floor(1000 + Math.random() * 9000)}`,
        ownerName,
        ownerPhone,
        petName,
        petSpecies,
        serviceName,
        date,
        time,
        symptoms
      };

      saveAppointments([newAppointment, ...currentList]);
      renderAppointments();
      form.reset();
      if (dateInput) dateInput.value = date;
      showFeedback(`¡Cita confirmada con éxito! Código de reserva: #${newAppointment.code}`, false);
    });

    // Filtros interactivos de Consejos de Cuidado Animal
    let activeCategory = 'Todos';
    const searchInput = document.getElementById('tip-search') as HTMLInputElement | null;
    const tipCards = document.querySelectorAll('.tip-card');
    const filterBtns = document.querySelectorAll('.tip-filter-btn');

    function filterTips() {
      const query = (searchInput?.value || '').toLowerCase().trim();
      tipCards.forEach((card) => {
        const el = card as HTMLElement;
        const cat = el.getAttribute('data-category') || '';
        const title = el.getAttribute('data-title') || '';
        const summary = el.getAttribute('data-summary') || '';

        const matchesCategory = activeCategory === 'Todos' || cat === activeCategory;
        const matchesQuery = !query || title.includes(query) || summary.includes(query);

        el.style.display = matchesCategory && matchesQuery ? 'flex' : 'none';
      });
    }

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeCategory = btn.getAttribute('data-category') || 'Todos';
        filterBtns.forEach((b) => {
          b.className = 'tip-filter-btn px-3.5 py-2 rounded-xl text-xs font-bold transition cursor-pointer bg-white text-slate-700 border border-slate-200 hover:bg-slate-100';
        });
        btn.className = 'tip-filter-btn px-3.5 py-2 rounded-xl text-xs font-bold transition cursor-pointer bg-teal-600 text-white';
        filterTips();
      });
    });

    searchInput?.addEventListener('input', filterTips);

    // Inicializar vista de citas guardadas
    renderAppointments();
  </script>
</Layout>